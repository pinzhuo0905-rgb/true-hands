# ===== 模型配置 =====
# 任何 OpenAI 兼容的服务都行：OpenAI / DeepSeek / 通义 / 本地 vLLM 等
MODEL_NAME=gpt-4o
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 桌面驱动配置 =====
# MCP 桌面服务器命令。留空则必须在命令行用 --driver-command 指定。
#
# Windows（推荐 Windows-MCP）：
#   GUI_DRIVER_COMMAND=C:\Users\<你>\.local\bin\windows-mcp.exe
#   GUI_DRIVER_ARGS=serve
#
# macOS（agent-desktop）：
#   GUI_DRIVER_COMMAND=/usr/local/bin/agent-desktop
#
# Linux（computer-use-linux）：
#   GUI_DRIVER_COMMAND=computer-use-linux
GUI_DRIVER_COMMAND=
GUI_DRIVER_ARGS=serve

# ===== 运行配置 =====
# 证据输出目录
RUNS_DIR=runs
# 单次任务最大步数
MAX_STEPS=40
